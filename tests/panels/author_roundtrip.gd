extends SceneTree
const Recorder=preload('res://scripts/crash_bake_recorder.gd')
const Clip=preload('res://scripts/baked_crash_clip.gd')
const Vehicle=preload('res://scripts/driving_vehicle.gd')
const States=preload('res://scripts/conditioned_crash_transitions.gd')
const Author=preload('res://scripts/conditioned_crash_authoring.gd')
func _initialize() -> void:call_deferred('_run')
func _run() -> void:
 var recorder:=Recorder.new();recorder.quality_multiplier=1;recorder.start(0,60)
 while not recorder.completed:recorder.step()
 var clip: Dictionary=recorder.result
 Clip.save(clip,'user://main_panel_author.crashclip',false)
 var disk: Dictionary=Clip.read('user://main_panel_author.crashclip')
 assert(disk.metadata.panels_schema==1 and disk.frames[0].has('mass_nodes'))
 assert(Clip.input_compatibility(disk).compatible)
 var v:=Vehicle.new();v.setup();v.solver.effects.begin_playback(disk.frames[0].effects)
 var offset:=Vector3(40,2,15);var rotation:=Basis.from_euler(Vector3(.2,.8,-.1))
 Clip.apply(v.solver,disk,1,offset,rotation)
 assert(v.solver.owned_mass_kg()>1209.99 and v.solver.owned_mass_kg()<1210.01)
 assert(v.solver.step_count==0 and v.solver.panels.active_steps==0)
 Clip.apply(v.solver,disk,disk.metadata.duration_s,Vector3.ZERO)
 var last: Dictionary=v.solver.capture()
 v.prepare_lightweight_panels()
 var described: Dictionary=States.describe(v.solver)
 var expected: Dictionary=States.describe(v.solver,last)
 var panel_reason: String=Clip.PanelState.compatible(described.panels,expected.panels)
 print('PANEL_AUTHOR_CANONICAL ',panel_reason,' active=',v.panel_states().map(func(p):return p.active),' modes=',v.panel_states().map(func(p):return p.reduced_mode))
 assert(panel_reason=='')
 # The following conditioned fixture starts from that frozen plastic car.
 Author.prepare(v.solver,{'angle':20.,'speed':60.},0)
 var original: Dictionary=v.solver.panels.capture()
 assert(original.panels.all(func(p):return not p.detached))
 print('PANEL_AUTHOR_ROUNDTRIP_PASS frames=',disk.frames.size(),' mass=',v.solver.owned_mass_kg(),' deformed=',last.panels.panels.map(func(p):return p.plastic_work))
 quit()
