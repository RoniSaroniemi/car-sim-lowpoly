+func _solve_link(l: Edge,dt: float) -> void:
+ if compact_active:
+  _solve_compact_link(l,dt)
+  return
+ if l.broken:return
+ var a: int=l.a
+ var b: int=l.b
+ var anchor:=Vector3.ZERO
+ if l.wheel_index>=0:anchor=wheels.anchor(l.wheel_index,l.wheel_anchor)
+ var d: Vector3=points[b]-points[a]-anchor
+ var distance: float=d.length()
+ if distance<0.00001:return
+ var normal: Vector3=d/distance
+ var denominator: float=l.denominator_cached
+ if l.wheel_index>=0:denominator=(l.weight_sum+wheels.rotational_weight(l.wheel_index,anchor,normal))+l.alpha_cached
+ var alpha: float=l.alpha_cached
+ var c: float=distance-l.length
+ var dl: float=(-c-alpha*l.lambda)/denominator
+ var trial: float=l.lambda+dl
+ var force: float=absf(trial)/(dt*dt)
+ l.peak_force=maxf(l.peak_force,force)
+ # Hardening and tension can only raise this lower bound; no material change
+ # is possible below it. The expensive plastic path still uses original math.
+ var lower_yield: float=l.yield_n*(0.55 if weak_rail and l.weak_eligible else 1.0)
+ if force>lower_yield:
+  var max_plastic: float=l.max_compression if trial>0 else l.max_extension
+  var amount: float=absf(l.length-l.original)/(l.compression_scale if trial>0 else l.extension_scale)
+  var yield_n: float=l.yield_n*(1.0+hardening*amount)
+  if trial<0:yield_n*=2.0
+  if weak_rail and l.weak_eligible:yield_n*=0.55
+  if force>yield_n and max_plastic>0:
+   var capped: float=signf(trial)*yield_n*dt*dt
+   var wanted: float=distance+alpha*capped
+   var new_length: float=clampf(wanted,l.minimum_length,l.maximum_length)
+   var delta: float=new_length-l.length
+   if absf(delta)>0.0000001:
+    l.length=new_length
+    l.plastic+=absf(delta)
+    plastic_work+=yield_n*absf(delta)
+    l.damage=maxf(l.damage,absf(new_length-l.original)/(l.compression_damage_scale if trial>0 else l.extension_damage_scale))
+    node_damage[a]=maxf(node_damage[a],minf(1.0,l.damage))
+    node_damage[b]=maxf(node_damage[b],minf(1.0,l.damage))
+    c=distance-new_length
+    dl=(-c-alpha*l.lambda)/denominator
+ l.lambda+=dl
+ points[a]-=normal*(inverse_masses[a]*dl)
+ points[b]+=normal*(inverse_masses[b]*dl)
+ if l.wheel_index>=0:wheels.correct_rotation(l.wheel_index,anchor,normal,-dl)
